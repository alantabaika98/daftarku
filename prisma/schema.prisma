generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  SCHOOL_ADMIN
  VERIFIER
}

enum LicenseStatus {
  PENDING
  ACTIVE
  EXPIRED
  SUSPENDED
}

enum SchoolLevel {
  TK
  RA
  KB
  TPA
  SD
  MI
  SMP
  MTs
  SMA
  MA
  SMK
  MAK
  TPQ
  SLB
  ASRAMA
  PONDOK_PESANTREN
  PENDIDIKAN_DINIYAH
  BOARDING_SCHOOL
  PERGURUAN_TINGGI
  TK_PAUD
  SD_MI
  SMP_MTS
  SMA_MA
}

enum ApplicantStatus {
  DRAFT
  SUBMITTED
  NEEDS_REVISION
  VERIFIED
  IN_SELECTION
  ACCEPTED
  REJECTED
  WITHDRAWN

  WAITLISTED
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_REVISION
}

enum NotificationChannel {
  WHATSAPP
  SYSTEM
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  MOCK_SENT
}

model School {
  id                 String      @id @default(cuid())
  name               String
  slug               String      @unique
  level              SchoolLevel @default(SD_MI)
  npsn               String?
  address            String?     @db.Text
  phone              String?
  whatsapp           String?
  email              String?
  logoUrl            String?
  bannerUrl          String?
  primaryColor       String      @default("#0F766E")
  description        String?     @db.Text
  registrationPrefix String      @default("DFK")
  isActive           Boolean     @default(true)
  deletedAt          DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  license            License?
  users              User[]
  periods            AdmissionPeriod[]
  paths              AdmissionPath[]
  requirements       DocumentRequirement[]
  formFields         FormFieldConfig[]
  applicants         Applicant[]
  documents          ApplicantDocument[]
  statusHistories    ApplicantStatusHistory[]
  notifications      NotificationLog[]
  auditLogs          AuditLog[]
  paymentMode         String   @default("FREE")
  useUniqueCode       Boolean  @default(true)
  allowInstallment    Boolean  @default(false)
  minDownPayment      Int      @default(0)
  maxInstallments     Int      @default(2)
  installmentNotes    String?
  bankAccountsJson    String?
  qrisImageUrl        String?
  externalPaymentUrl  String?
  paymentInstructions String?
  cardPrintRule       String   @default("AFTER_UPLOAD")
  visionMission      String?
  highlights         String?
  cardNotes          String?
  schoolPhotoUrl     String?
  quotaBalance            Int                        @default(30)
  foundationBalance       Int                        @default(0)
  platformRegFee          Int                        @default(5000)
  platformReRegFee        Int                        @default(10000)
  reRegMode               ReRegPaymentMode           @default(MANUAL)
  reRegFeeAmount          Int                        @default(0)
  reRegAllowInstallment   Boolean                    @default(false)
  invoices                Invoice[]
  foundationLedgers       FoundationLedger[]
  foundationWithdrawals   FoundationWithdrawal[]
  cloudStorageOrders      CloudStoragePackageOrder[]
}

model License {
  id          String        @id @default(cuid())
  schoolId    String        @unique
  school      School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  licenseKey  String        @unique
  planName    String        @default("LIFETIME_BASIC")
  status      LicenseStatus @default(PENDING)
  activatedAt DateTime?
  expiresAt   DateTime?
  notes       String?       @db.Text
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model User {
  id            String    @id @default(cuid())
  schoolId      String?
  school        School?   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name          String
  email         String    @unique
  passwordHash  String
  role          UserRole  @default(SCHOOL_ADMIN)
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  reviewedDocs  ApplicantDocument[]      @relation("DocumentReviewer")
  statusChanges ApplicantStatusHistory[] @relation("StatusChanger")
  auditLogs     AuditLog[]

  @@index([schoolId])
}

model AdmissionPeriod {
  id               String    @id @default(cuid())
  schoolId         String
  school           School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name             String
  academicYear     String
  waveNumber         Int      @default(1)
  quota              Int      @default(100)
  benefits           String?
  startDate        DateTime
  endDate          DateTime
  announcementDate DateTime?
  isActive         Boolean   @default(true)
  isPublicOpen     Boolean   @default(true)
  sequenceCounter  Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  paths            AdmissionPath[]
  requirements     DocumentRequirement[]
  formFields       FormFieldConfig[]
  applicants       Applicant[]

  @@index([schoolId, isActive])
  registrationFee     Int      @default(0)
}

model AdmissionPath {
  id          String          @id @default(cuid())
  schoolId    String
  school      School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  periodId    String
  period      AdmissionPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  name        String
  description String?         @db.Text
  quota       Int             @default(0)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  applicants  Applicant[]

  @@index([schoolId, periodId])
}

model DocumentRequirement {
  id           String          @id @default(cuid())
  schoolId     String
  school       School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  periodId     String
  period       AdmissionPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  isRequired   Boolean         @default(true)
  allowedTypes String          @default("pdf,jpg,jpeg,png")
  uploadMethod       String   @default("CAMERA_OR_PDF")
  maxSizeMb    Int             @default(2)
  sortOrder    Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  documents    ApplicantDocument[]

  @@index([schoolId, periodId])
}

model FormFieldConfig {
  id          String          @id @default(cuid())
  schoolId    String
  school      School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  periodId    String
  period      AdmissionPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  fieldKey    String
  label       String
  fieldType   String          @default("text")
  optionsJson String?         @db.Text
  isRequired  Boolean         @default(false)
  isEnabled   Boolean         @default(true)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([periodId, fieldKey])
  @@index([schoolId, periodId])
}

model Applicant {
  id                 String          @id @default(cuid())
  schoolId           String
  school             School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  periodId           String
  period             AdmissionPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)
  pathId             String?
  path               AdmissionPath?  @relation(fields: [pathId], references: [id], onDelete: SetNull)
  registrationNumber String
  accessToken        String          @unique
  fullName           String
  nik                String?
  birthPlace         String?
  birthDate          DateTime?
  gender             String?
  address            String?         @db.Text
  parentName         String
  parentWhatsapp     String
  previousSchool     String?
  customData         Json?
  status             ApplicantStatus @default(SUBMITTED)
  adminNotes         String?         @db.Text
  submittedAt        DateTime?
  verifiedAt         DateTime?
  announcedAt        DateTime?
  deletedAt          DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  documents          ApplicantDocument[]
  statusHistory      ApplicantStatusHistory[]
  notifications      NotificationLog[]

  @@unique([schoolId, registrationNumber])
  @@index([schoolId, status])
  @@index([schoolId, periodId])
  nisn             String?
  originSchool     String?
  parentPhone      String?
  studentPhotoUrl  String?
  uploadedDocsJson String?
  paymentStatus    String   @default("UNPAID")
  uniqueCode       Int      @default(0)
  expectedAmount   Int      @default(0)
  paidAmount       Int      @default(0)
  paymentProofUrl  String?
  paymentNote      String?
  isReRegistered   Boolean  @default(false)
  reRegisteredAt   DateTime?
  verifierNote     String?
  customDataJson   String?
  isLockedByQuota         Boolean                    @default(false)
  unlockedAt              DateTime?
  invoices                Invoice[]
}

model ApplicantDocument {
  id            String               @id @default(cuid())
  schoolId      String
  school        School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  applicantId   String
  applicant     Applicant            @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  requirementId String?
  requirement   DocumentRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  fileName      String
  storagePath   String
  mimeType      String
  fileSizeBytes Int
  status        DocumentStatus       @default(PENDING)
  reviewNote    String?
  reviewedById  String?
  reviewedBy    User?                @relation("DocumentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([schoolId, applicantId])
}

model ApplicantStatusHistory {
  id          String           @id @default(cuid())
  schoolId    String
  school      School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  applicantId String
  applicant   Applicant        @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  fromStatus  ApplicantStatus?
  toStatus    ApplicantStatus
  note        String?          @db.Text
  changedById String?
  changedBy   User?            @relation("StatusChanger", fields: [changedById], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())

  @@index([schoolId, applicantId])
}

model NotificationLog {
  id               String              @id @default(cuid())
  schoolId         String
  school           School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  applicantId      String?
  applicant        Applicant?          @relation(fields: [applicantId], references: [id], onDelete: SetNull)
  recipientPhone   String
  channel          NotificationChannel @default(WHATSAPP)
  templateCode     String
  messageBody      String              @db.Text
  status           NotificationStatus  @default(QUEUED)
  providerResponse String?             @db.Text
  createdAt        DateTime            @default(now())

  @@index([schoolId, createdAt])
}

model AuditLog {
  id           String   @id @default(cuid())
  schoolId     String?
  school       School?  @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  actorUserId  String?
  actorUser    User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action       String
  targetEntity String
  targetId     String?
  metadata     Json?
  ipAddress    String?
  createdAt    DateTime @default(now())

  @@index([schoolId, createdAt])
}

enum ReRegPaymentMode {
  MANUAL
  AUTOMATIC_VA
}

enum InvoicePhase {
  INITIAL_REGISTRATION
  RE_REGISTRATION
}

enum InvoiceStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  EXPIRED
  CANCELLED
}

enum FoundationLedgerType {
  CREDIT_REGISTRATION
  CREDIT_REREGISTRATION
  DEBIT_WITHDRAWAL
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  COMPLETED
  REJECTED
}

enum CloudStorageOrderStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
}

model Invoice {
  id                  String               @id @default(cuid())
  invoiceNumber       String               @unique
  schoolId            String
  school              School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  applicantId         String
  applicant           Applicant            @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  phase               InvoicePhase         @default(INITIAL_REGISTRATION)
  paymentMethod       String               @default("VIRTUAL_ACCOUNT")
  gatewayProvider     String?
  bankCode            String?
  vaNumber            String?
  gatewayExternalId   String?              @unique
  gatewayPaymentUrl   String?
  baseAmount          Int
  adminBankFee        Int                  @default(0)
  totalAmount         Int
  paidAmount          Int                  @default(0)
  platformFee         Int                  @default(0)
  foundationNetAmount Int                  @default(0)
  isSplitSettled      Boolean              @default(false)
  status              InvoiceStatus        @default(PENDING)
  expiresAt           DateTime?
  paidAt              DateTime?
  notes               String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  installments        InvoiceInstallment[]
  ledgerEntries       FoundationLedger[]

  @@index([schoolId, phase, status])
  @@index([applicantId, phase])
  qrisPayload         String?
}

model InvoiceInstallment {
  id                String    @id @default(cuid())
  invoiceId         String
  invoice           Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  installmentNumber Int
  amount            Int
  vaNumber          String?
  gatewayTxId       String?   @unique
  proofUrl          String?
  status            String    @default("PENDING")
  paidAt            DateTime?
  createdAt         DateTime  @default(now())

  @@index([invoiceId])
}

model FoundationLedger {
  id           String                @id @default(cuid())
  schoolId     String
  school       School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  invoiceId    String?
  invoice      Invoice?              @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  withdrawalId String?
  withdrawal   FoundationWithdrawal? @relation(fields: [withdrawalId], references: [id], onDelete: SetNull)
  type         FoundationLedgerType
  grossAmount  Int
  platformFee  Int                   @default(0)
  netAmount    Int
  balanceAfter Int
  description  String
  createdAt    DateTime              @default(now())

  @@index([schoolId, createdAt])
}

model FoundationWithdrawal {
  id                 String             @id @default(cuid())
  schoolId           String
  school             School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  requestedByUserId  String
  amount             Int
  bankName           String
  accountNumber      String
  accountHolder      String
  status             WithdrawalStatus   @default(PENDING)
  transferReceiptUrl String?
  adminNote          String?
  processedAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  ledgerEntries      FoundationLedger[]

  @@index([schoolId, status])
}

model CloudStoragePackageOrder {
  id                String                  @id @default(cuid())
  orderNumber       String                  @unique
  schoolId          String
  school            School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  packageName       String                  @default("Paket Kapasitas Penyimpanan Cloud (+200 Data Pendaftar)")
  quotaAdded        Int                     @default(200)
  amount            Int                     @default(600000)
  vaNumber          String?
  gatewayExternalId String?                 @unique
  gatewayPaymentUrl String?
  status            CloudStorageOrderStatus @default(PENDING)
  paidAt            DateTime?
  createdAt         DateTime                @default(now())

  @@index([schoolId, status])
}

model PlatformTreasuryLedger {
  id           String   @id @default(cuid())
  schoolId     String?
  schoolName   String   @default("")
  sourceType   String   // CLOUD_STORAGE_PACKAGE | VA_REGISTRATION_FEE | VA_REREGISTRATION_FEE | DISBURSEMENT
  referenceNo  String
  grossAmount  Int
  netAmount    Int      // + masuk ke tampungan super admin, - pencairan dana
  balanceAfter Int
  description  String
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

model PlatformWithdrawal {
  id              String   @id @default(cuid())
  disbursementNo  String   @unique
  amount          Int
  bankName        String
  accountNumber   String
  accountHolder   String
  status          String   @default("COMPLETED") // COMPLETED | PROCESSING
  referenceNote   String?
  disbursedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
}